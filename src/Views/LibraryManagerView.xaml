<Window x:Class="XcTools.Views.LibraryManagerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="小辰CAD工具箱 v1.0.0 QQ交流群:964066654"
        Height="600" Width="900"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Window.Resources>
        <DrawingImage x:Key="InsertIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#333333">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M20,10 L20,20 L10,20 L10,25 L25,25 L25,10 Z M4,14 L4,28 L18,28 L18,14 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="RenameIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#333333">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M20,4 L4,4 L4,28 L18,28 L18,14 L20,14 Z M10,10 L14,10 L14,20 L10,20 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="DeleteIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#E53935">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M4,8 L4,28 L24,28 L24,8 Z M10,12 L10,22 L18,22 L18,12 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderThickness="0,0,0,1" BorderBrush="#DDDDDD">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- 左侧固定区域 -->
                <TextBlock Grid.Column="0" Text="图库目录:" Margin="10,5,0,5" VerticalAlignment="Center" FontSize="12" Foreground="#333333"/>
                <TextBox Grid.Column="1" x:Name="txtCurrentPath" Height="25" Margin="5" FontSize="12" Background="#FFFFFF" BorderBrush="#DDDDDD" IsReadOnly="True"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="5">
                    <Button Content="更换目录..." Width="75" Height="25" Margin="2" FontSize="12" Click="BrowseButton_Click"/>
                </StackPanel>
                
                <!-- 右侧自适应区域 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button x:Name="btnFirstPage" Content="首页" Width="70" Height="25" Margin="2" FontSize="12" Click="FirstPageButton_Click" IsEnabled="False"/>
                    <Button x:Name="btnPrevPage" Content="上一页" Width="70" Height="25" Margin="2" FontSize="12" Click="PrevPageButton_Click" IsEnabled="False"/>
                    <Button x:Name="btnNextPage" Content="下一页" Width="70" Height="25" Margin="2" FontSize="12" Click="NextPageButton_Click" IsEnabled="False"/>
                    <Button x:Name="btnLastPage" Content="尾页" Width="70" Height="25" Margin="2" FontSize="12" Click="LastPageButton_Click" IsEnabled="False"/>
                    <Button Content="选图入库" Width="80" Height="25" Margin="2" FontSize="12" Click="AddButton_Click"/>
                    <Button Content="删除图块" Width="80" Height="25" Margin="2" FontSize="12" Click="DeleteButton_Click"/>
                    <Button Content="刷新" Width="60" Height="25" Margin="2" FontSize="12" Click="RefreshButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- 主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- 左侧区域：分类树 + 功能按钮 -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderThickness="0,0,1,0" BorderBrush="#DDDDDD">
                <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- 分类树标题 -->
                    <TextBlock Grid.Row="0" Text="图库分类:" Margin="10,5,0,5" FontSize="12" FontWeight="Bold" Foreground="#333333"/>
                    
                    <!-- 分类树 -->
                    <TreeView Grid.Row="1" x:Name="categoryTreeView" Margin="5" Background="Transparent" BorderThickness="0">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="Padding" Value="2"/>
                                <Setter Property="Margin" Value="1"/>
                                <EventSetter Event="MouseDoubleClick" Handler="Category_MouseDoubleClick"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding SubCategories}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#333333"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    
                    <!-- 功能按钮 -->
                    <Border Grid.Row="3" Background="#F9F9F9" BorderThickness="0,1,0,0" BorderBrush="#DDDDDD">
                        <StackPanel Orientation="Vertical" Margin="5">
                            <Button x:Name="btnHelp" Content="帮助" Width="165" Height="28" Margin="2" FontSize="12" Click="HelpButton_Click"/>
                            <Button x:Name="btnClose" Content="关闭" Width="165" Height="28" Margin="2" FontSize="12" Click="CloseButton_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            
            <!-- 右侧图块列表 -->
            <Grid Grid.Column="1">
                <ListBox x:Name="fileListView" 
                         SelectionMode="Single" 
                         MouseDoubleClick="FileListView_MouseDoubleClick" 
                         Background="#F5F5F5" 
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseRightButtonDown="FileListView_MouseRightButtonDown">
                    <ListBox.ContextMenu>
                        <ContextMenu x:Name="fileContextMenu">
                            <MenuItem Header="插入" Click="ContextMenu_Insert_Click" Icon="{StaticResource InsertIcon}"/>
                            <MenuItem Header="重命名" Click="ContextMenu_Rename_Click" Icon="{StaticResource RenameIcon}"/>
                            <Separator/>
                            <MenuItem Header="删除" Click="ContextMenu_Delete_Click" Icon="{StaticResource DeleteIcon}"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" BorderBrush="#DDDDDD" Margin="5" Background="#FFFFFF" Width="140" Height="130" Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="#5A9FD4"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Image Grid.Row="0" Source="{Binding Thumbnail}" Width="135" Height="95" Stretch="Uniform" Margin="2" VerticalAlignment="Center"/>
                                    <Border Grid.Row="1" Background="#F5F5F5" Height="28" BorderThickness="0,1,0,0" BorderBrush="#DDDDDD">
                                        <TextBlock Text="{Binding DisplayName}" Margin="4,4" TextTrimming="CharacterEllipsis" TextAlignment="Center" FontSize="11" Foreground="#333333"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</Window>