<Window x:Class="XcTools.Views.LibraryManagerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="小辰CAD工具箱 v1.0.1    By：Xiaochen"
        Height="600" Width="900"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#FAFBFC">
    <Window.Resources>
        <!-- 配色方案：现代蓝灰主题 -->
        <Color x:Key="PrimaryColor">#2C5F8D</Color>
        <Color x:Key="AccentColor">#3498DB</Color>
        <Color x:Key="TextColor">#2C3E50</Color>
        <Color x:Key="MutedTextColor">#7F8C8D</Color>
        <Color x:Key="BorderColor">#E0E6ED</Color>
        <Color x:Key="HoverBgColor">#EBF3FB</Color>
        <Color x:Key="CardBgColor">#FFFFFF</Color>

        <DrawingImage x:Key="InsertIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#2C5F8D">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M20,10 L20,20 L10,20 L10,25 L25,25 L25,10 Z M4,14 L4,28 L18,28 L18,14 Z M10,10 L14,10 L14,20 L10,20 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="RenameIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#2C5F8D">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M20,4 L4,4 L4,28 L18,28 L18,14 L20,14 Z M10,10 L14,10 L14,20 L10,20 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="DeleteIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#E74C3C">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M4,8 L4,28 L24,28 L24,8 Z M10,12 L10,22 L18,22 L18,12 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- 主按钮样式：圆角、悬停渐变 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#2C5F8D"/>
            <Setter Property="BorderBrush" Value="#2C5F8D"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3498DB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#BDC3C7"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1F4E7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次级按钮样式：浅底蓝字 -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#2C5F8D"/>
            <Setter Property="Background" Value="#EBF3FB"/>
            <Setter Property="BorderBrush" Value="#D6E4F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D6E4F0"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#3498DB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#F4F6F8"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#E0E6ED"/>
                                <Setter Property="Foreground" Value="#BDC3C7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C5D9E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 危险按钮样式：删除/移除类操作 -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#E74C3C"/>
            <Setter Property="Background" Value="#FDECEA"/>
            <Setter Property="BorderBrush" Value="#F5B7B1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F5B7B1"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#E74C3C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C0392B"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TreeViewItem 悬停效果 -->
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <EventSetter Event="MouseDoubleClick" Handler="Category_MouseDoubleClick"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EBF3FB"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#D6E4F0"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ListBoxItem 悬停浮起效果 -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderThickness="0,0,0,1" BorderBrush="#E0E6ED">
            <Grid Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="图库目录" Margin="0,0,8,0" VerticalAlignment="Center"
                           FontSize="12" FontWeight="SemiBold" Foreground="#2C5F8D"/>
                <TextBox Grid.Column="1" x:Name="txtCurrentPath" Height="28" FontSize="12"
                         Background="#F4F6F8" BorderBrush="#E0E6ED" BorderThickness="1"
                         Padding="6,4" IsReadOnly="True" VerticalContentAlignment="Center"
                         Foreground="#5D6D7E"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="更换目录..." Width="80" Height="28" Margin="0,0,4,0"
                            Style="{StaticResource SecondaryButtonStyle}" Click="BrowseButton_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="btnFirstPage" Content="首页" Width="50" Height="28" Margin="2,0"
                            Style="{StaticResource SecondaryButtonStyle}" Click="FirstPageButton_Click" IsEnabled="False"/>
                    <Button x:Name="btnPrevPage" Content="上一页" Width="60" Height="28" Margin="2,0"
                            Style="{StaticResource SecondaryButtonStyle}" Click="PrevPageButton_Click" IsEnabled="False"/>
                    <Button x:Name="btnNextPage" Content="下一页" Width="60" Height="28" Margin="2,0"
                            Style="{StaticResource SecondaryButtonStyle}" Click="NextPageButton_Click" IsEnabled="False"/>
                    <Button x:Name="btnLastPage" Content="尾页" Width="50" Height="28" Margin="2,0"
                            Style="{StaticResource SecondaryButtonStyle}" Click="LastPageButton_Click" IsEnabled="False"/>
                    <Border Width="1" Background="#E0E6ED" Margin="8,4"/>
                    <Button Content="选图入库" Width="76" Height="28" Margin="2,0"
                            Style="{StaticResource PrimaryButtonStyle}" Click="AddButton_Click"/>
                    <Button Content="删除图块" Width="76" Height="28" Margin="2,0"
                            Style="{StaticResource DangerButtonStyle}" Click="DeleteButton_Click"/>
                    <Button Content="刷新" Width="50" Height="28" Margin="2,0"
                            Style="{StaticResource SecondaryButtonStyle}" Click="RefreshButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：分类树 + 功能按钮 -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderThickness="0,0,1,0" BorderBrush="#E0E6ED">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 分类标题 -->
                    <Border Grid.Row="0" Background="#F4F6F8" BorderThickness="0,0,0,1" BorderBrush="#E0E6ED">
                        <TextBlock Text="图库分类" Margin="12,8" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#2C5F8D"/>
                    </Border>

                    <!-- 分类树 -->
                    <TreeView Grid.Row="1" x:Name="categoryTreeView" Margin="4" Background="Transparent"
                              BorderThickness="0" FontSize="12">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding SubCategories}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▸" FontSize="9" Foreground="#7F8C8D" Margin="0,0,4,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" Foreground="#2C3E50"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <!-- 功能按钮区 -->
                    <Border Grid.Row="2" Background="#F4F6F8" BorderThickness="0,1,0,0" BorderBrush="#E0E6ED">
                        <StackPanel Orientation="Vertical" Margin="8,8">
                            <Button x:Name="btnHelp" Content="帮助" Width="180" Height="30" Margin="0,0,0,4"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="HelpButton_Click"/>
                            <Button x:Name="btnClose" Content="关闭" Width="180" Height="30"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="CloseButton_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 右侧图块列表 -->
            <Grid Grid.Column="1" Background="#FAFBFC">
                <ListBox x:Name="fileListView"
                         SelectionMode="Single"
                         MouseDoubleClick="FileListView_MouseDoubleClick"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseRightButtonDown="FileListView_MouseRightButtonDown">
                    <ListBox.ContextMenu>
                        <ContextMenu x:Name="fileContextMenu">
                            <MenuItem Header="插入" Click="ContextMenu_Insert_Click" Icon="{StaticResource InsertIcon}"/>
                            <MenuItem Header="重命名" Click="ContextMenu_Rename_Click" Icon="{StaticResource RenameIcon}"/>
                            <Separator/>
                            <MenuItem Header="删除" Click="ContextMenu_Delete_Click" Icon="{StaticResource DeleteIcon}"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"
                                       ItemWidth="160" ItemHeight="160"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="card" BorderThickness="1" BorderBrush="#E0E6ED"
                                    Margin="3" Background="#FFFFFF"
                                    CornerRadius="3" Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="#3498DB"/>
                                                <Setter Property="Background" Value="#F8FBFE"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.Effect>
                                    <DropShadowEffect Color="#2C5F8D" BlurRadius="0" ShadowDepth="0"
                                                      Direction="90" Opacity="0"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#F4F6F8" CornerRadius="3,3,0,0" ClipToBounds="True">
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="UniformToFill" Margin="0"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="1" Background="#FFFFFF" Height="30"
                                            BorderThickness="0,1,0,0" BorderBrush="#E0E6ED"
                                            CornerRadius="0,0,3,3">
                                        <TextBlock Text="{Binding DisplayName}" Margin="6,0"
                                                   TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                                   FontSize="11" Foreground="#2C3E50"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <!-- 底部状态栏：作者署名 + QQ 交流群 -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderThickness="0,1,0,0" BorderBrush="#E0E6ED">
            <Grid Margin="12,6">
                <TextBlock Text="By：Xiaochen" FontSize="11" Foreground="#7F8C8D"
                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11" Cursor="Hand"
                           MouseLeftButtonDown="QqLink_Click" ToolTip="点击复制群号">
                    <Run Text="QQ交流群：" Foreground="#7F8C8D"/>
                    <Run Text="964066654" Foreground="#3498DB" FontWeight="SemiBold"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
